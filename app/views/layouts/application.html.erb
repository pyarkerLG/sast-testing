<!DOCTYPE html>
<html>
<head>
  <title>RailsGoat</title>
  <%= stylesheet_link_tag    "application", media: "all", "data-turbolinks-track" => true %>
  <%= javascript_include_tag "application", "data-turbolinks-track" => true %>
  <%#= csrf_meta_tags %> <!-- <~ What is this for? I hear it helps w/ JS and Sea-surfing.....whatevz -->
  <!-- bootstrap css -->
<%
if cookies[:font]
  # Map whitelisted font values to safe CSS classes
  font_class = case cookies[:font]
               when 'small'
                 'font-small'
               when 'medium'
                 'font-medium'
               when 'large'
                 'font-large'
               else
                 'font-medium' # default fallback
               end
%>
<style>
  body.font-small { font-size: 12px !important; }
  body.font-medium { font-size: 14px !important; }
  body.font-large { font-size: 16px !important; }
</style>
<%
end
%>

</head>
<body<% if cookies[:font] && ['small', 'medium', 'large'].include?(cookies[:font]) %> class="font-<%= cookies[:font] %>"<% end %>>
  <%= render "layouts/shared/header" %>
  <%= render "layouts/shared/sidebar" %>
<div class="container-fluid">
  <% if current_user %>
    <div class="dashboard-wrapper">
      <%= render "layouts/shared/messages" %>
      <%= yield %>
    </div>
  <% else %>
  <div class="login-wrapper">
    <%= render "layouts/shared/messages" %>
    <%= yield %> 
  </div>  
  <% end %>
</div>
  <%= render "layouts/shared/footer" %>

<script type="text/javascript">

//Dropdown
$('.dropdown-toggle').dropdown();
</script>

</body>
</html>
